{#- Shared SQL building blocks. All identifiers are validated as plain SQL identifiers upstream. -#}

{% macro header(r, title) -%}
-- Databricks notebook source
-- {{ title }}
-- Bundle: {{ r.bundle_name }} v{{ r.version }} (pattern: {{ r.pattern.value }})
-- Generated by Databricks Agent. Do not edit by hand: change request.json and regenerate.
{%- endmacro %}

{% macro source_view(view, p) -%}
-- Read the source and add lineage columns to every row.
CREATE OR REPLACE TEMPORARY VIEW {{ view }} AS
SELECT
  *,
  _metadata.file_path AS _source_file,
  current_timestamp() AS _ingested_at
{% set opts = ["format => '" ~ p.source_format ~ "'"] %}
{% if p.source_format == 'csv' %}
{% set opts = opts + ["header => " ~ (p.has_header | lower), "delimiter => '" ~ p.delimiter ~ "'", "inferSchema => true"] %}
{% endif %}
FROM read_files(
  '{{ p.source_path }}',
  {{ opts | join(',\n  ') }}
);
{%- endmacro %}

{% macro layout(p) %}
{% if p.cluster_by %}
CLUSTER BY ({{ p.cluster_by | join(', ') }})
{% elif p.partition_columns %}
PARTITIONED BY ({{ p.partition_columns | join(', ') }})
{% endif %}
{% endmacro %}

{% macro fail_if(condition_query, message) -%}
SELECT raise_error(concat('DQ check failed: {{ message }} (', CAST(n AS STRING), ')'))
FROM ({{ condition_query }})
WHERE n > 0;
{%- endmacro %}

{% macro not_null_check(view, columns, what) -%}
{%- set cond -%}
{% for c in columns %}{{ c }} IS NULL{{ ' OR ' if not loop.last }}{% endfor %}
{%- endset -%}
-- DQ: {{ what }} must not be NULL.
{{ fail_if("SELECT COUNT(*) AS n FROM " ~ view ~ " WHERE " ~ cond, "NULL " ~ what) }}
{%- endmacro %}

{% macro audit(r) -%}
-- Audit: one row per successful run.
CREATE TABLE IF NOT EXISTS {{ r.audit_table }} (
  bundle_name STRING,
  bundle_version STRING,
  table_name STRING,
  loaded_at TIMESTAMP,
  rows_loaded BIGINT,
  status STRING
);

INSERT INTO {{ r.audit_table }}
VALUES ('{{ r.bundle_name }}', '{{ r.version }}', '{{ r.target_table }}', current_timestamp(), rows_loaded, 'SUCCEEDED');
{%- endmacro %}
